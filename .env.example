# ============================================================
# AFRICAN TRUST FUND - VARIABLES D'ENVIRONNEMENT
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# ============================================================
# BASE DE DONNÉES
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=african_trust_fund
DB_CHARSET=utf8mb4

# ============================================================
# API GEMINI (Google AI)
# ============================================================
# À obtenir: https://ai.google.dev/
GEMINI_API_KEY=votre_cle_api_gemini_ici
GEMINI_MODEL=gemini-3.5-flash

# ============================================================
# MAISHA PAY (Paiements)
# ============================================================
MAISHAPAY_API_KEY=votre_cle_maishapay_ici
MAISHAPAY_SECRET_KEY=votre_secret_maishapay_ici
MAISHAPAY_MERCHANT_ID=votre_merchant_id_ici

# ============================================================
# CONFIGURATION APPLICATIF
# ============================================================
APP_ENV=production
APP_DEBUG=false
APP_URL=https://votresiteweb.com
APP_NAME=African Trust Fund

# ============================================================
# SÉCURITÉ
# ============================================================
CIPHER_KEY=votre_cle_chiffrement_ici
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW=900

# ============================================================
# EMAIL (Optionnel)
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre_email@gmail.com
MAIL_PASSWORD=votre_mot_de_passe_app_gmail
MAIL_FROM_ADDRESS=noreply@african-trust-fund.com
MAIL_FROM_NAME=African Trust Fund

# ============================================================
# LOGS
# ============================================================
LOG_LEVEL=info
LOG_PATH=/var/log/african-trust-fund/

# ============================================================
# MODE MAINTENANCE
# ============================================================
MAINTENANCE_MODE=false
MAINTENANCE_WHITELIST_IPS=127.0.0.1,::1
