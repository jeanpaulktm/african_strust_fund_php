# ============================================================
# ROUTAGE API V1 - African Trust Fund
# ============================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /african-trust-fund/api/v1/

    # Activer CORS
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-CSRF-Token"

    # Rediriger toutes les requêtes vers index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]

    # Éviter les boucles infinies
    RewriteCond %{REQUEST_URI} !^/index\.php$

    # Autoriser les accès directs aux fichiers
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
</IfModule>

# ============================================================
# PHP SETTINGS
# ============================================================
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_input_vars 5000
</IfModule>

# ============================================================
# CACHE CONTROL
# ============================================================
<FilesMatch "\.(jpg|jpeg|png|gif|ico|css|js)$">
    Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# ============================================================
# SÉCURITÉ
# ============================================================
<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
    Allow from 127.0.0.1
    Allow from all
</FilesMatch>

# Bloquer l'accès aux fichiers sensibles
<FilesMatch "\.(env|json|txt)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>
